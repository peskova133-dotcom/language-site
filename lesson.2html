<!DOCTYPE html>

<html lang="ru"><head><meta charset="utf-8"/><meta content="width=device-width, initial-scale=1" name="viewport"/><title>КЛЮЧ РЕМОНТ — ремонт квартир под ключ</title><style>
:root{--ink:#20201e;--sand:#d5b68a;--cream:#f8f7f4;--muted:#77736c}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:Arial,Helvetica,sans-serif;background:var(--cream);color:var(--ink)}button,input,select,textarea{font:inherit}button{cursor:pointer}a{text-decoration:none;color:inherit}.wrap{max-width:1240px;margin:auto;padding:0 30px}.hero{min-height:660px;background:linear-gradient(90deg,rgba(15,15,15,.88) 0%,rgba(15,15,15,.52) 47%,rgba(15,15,15,.15) 100%),url('data:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,') center/cover;color:white;position:relative}.nav{display:flex;align-items:center;justify-content:space-between;padding:24px 0;gap:24px}.brand{font-size:19px;font-weight:800;letter-spacing:.02em;white-space:nowrap}.brand span{color:var(--sand);font-size:26px;margin-right:8px}.brand small{display:block;font-size:8px;letter-spacing:1.8px;margin-left:36px;font-weight:400;color:#c8c2ba}.links{display:flex;gap:23px;font-size:12px}.links a:hover{color:var(--sand)}.btn{border:1px solid transparent;border-radius:5px;background:var(--sand);color:#191919;padding:15px 22px;display:inline-flex;gap:24px;align-items:center;justify-content:center;font-size:13px;font-weight:700;transition:.2s}.btn:hover{transform:translateY(-2px);background:#e9cba0}.btn.outline{background:transparent;border-color:#b3aaa0;color:inherit}.btn.outline:hover{background:#ffffff20}.hero-body{padding:100px 0 78px;max-width:660px}.eyebrow{font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--sand);font-weight:700}.hero h1{font-size:clamp(43px,5.3vw,75px);line-height:1.04;letter-spacing:-2.5px;margin:20px 0}.hero p{max-width:450px;color:#e3ded7;font-size:16px;line-height:1.65}.hero-actions{display:flex;gap:12px;margin-top:28px;flex-wrap:wrap}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;padding-bottom:25px}.stat{background:rgba(25,24,23,.9);border:1px solid #ffffff22;border-radius:10px;padding:24px;min-height:112px}.stat strong{font-size:23px}.stat span{display:block;color:#d0cac1;font-size:12px;line-height:1.5;margin-top:9px}section{padding:85px 0}.section-head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:30px}.section-head h2,h2{font-size:clamp(30px,3.2vw,45px);letter-spacing:-1.4px;margin:8px 0 0;line-height:1.12}.sub{color:var(--muted);line-height:1.6;max-width:510px}.services{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}.service{background:white;border:1px solid #ddd9d3;border-radius:10px;overflow:hidden;display:flex;flex-direction:column}.service-body{padding:24px;flex:1}.service .symbol{font-size:29px;color:#b69769}.service h3{font-size:18px;margin:16px 0 9px}.service p{font-size:13px;color:#777;line-height:1.5}.service img{width:100%;height:180px;object-fit:cover}.advantages{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}.adv{padding:12px 20px;border-left:1px solid #ddd7cf}.adv b{display:block;margin:10px 0}.adv p{font-size:13px;line-height:1.5;color:#777}.adv .symbol{font-size:26px;color:#bd9d71}.dark{background:#242321;color:white}.projects{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.project{position:relative;min-height:265px;overflow:hidden;border-radius:9px;background:#51463e}.project img{width:100%;height:265px;object-fit:cover;transition:transform .3s}.project:hover img{transform:scale(1.05)}.project .overlay{position:absolute;inset:auto 0 0;background:linear-gradient(transparent,#000c);padding:45px 20px 18px}.overlay b{display:block;font-size:19px}.overlay span{font-size:12px;color:#ddd}.compare-layout{display:grid;grid-template-columns:1.4fr 1fr;gap:40px;align-items:center}.compare{position:relative;height:430px;overflow:hidden;border-radius:12px;touch-action:pan-y;background:#bbb}.compare img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.compare .before{clip-path:inset(0 50% 0 0)}.compare .line{position:absolute;top:0;bottom:0;left:50%;width:3px;background:white;box-shadow:0 0 0 1px #3333;pointer-events:none}.handle{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);background:white;border-radius:50%;width:54px;height:54px;display:grid;place-items:center;box-shadow:0 2px 20px #0004;pointer-events:none}.tag{position:absolute;top:18px;padding:8px 12px;background:#222b;color:white;border-radius:5px;font-size:12px}.tag.left{left:16px}.tag.right{right:16px}.compare input{position:absolute;inset:0;width:100%;height:100%;opacity:0;cursor:ew-resize}.tabs{display:flex;gap:9px;flex-wrap:wrap;margin:25px 0}.tab{border:1px solid #cfc8bd;border-radius:6px;background:transparent;padding:12px 17px}.tab.active{background:#222;color:white;border-color:#222}.about-grid{display:grid;grid-template-columns:1fr 1fr;gap:55px;align-items:center}.about-img{height:370px;border-radius:12px;object-fit:cover;width:100%}.check{padding:10px 0;border-bottom:1px solid #e0dcd6;font-size:15px}.reviews{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.review{border:1px solid #d9d4cd;background:white;border-radius:10px;padding:28px}.stars{color:#b6925d;letter-spacing:3px}.review p{line-height:1.7;font-size:14px;color:#5e5a55;min-height:110px}.review small{color:#888}.calc-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:35px}.form-box{border:1px solid #ded9d2;background:white;border-radius:12px;padding:28px}.form-box label{display:block;font-size:13px;font-weight:700;margin:17px 0 8px}.form-box input,.form-box select,.form-box textarea{width:100%;border:1px solid #d8d2c8;background:#fbfaf8;border-radius:5px;padding:14px;color:#222}.form-box input[type=range]{padding:0;accent-color:#b89a6e}.options{display:flex;gap:9px;flex-wrap:wrap}.choice{padding:12px 16px;border:1px solid #ddd6cd;background:white;border-radius:5px}.choice.active{background:#262522;color:white;border-color:#262522}.checks label{font-weight:400;display:flex;align-items:center;gap:10px;margin:14px 0}.checks input{width:auto;accent-color:#ae8a58}.estimate{background:#242321;color:white;border-radius:12px;padding:32px;align-self:start;position:sticky;top:20px}.estimate .price{font-size:clamp(35px,4vw,56px);font-weight:800;margin:20px 0;letter-spacing:-2px}.estimate p{color:#c9c4bc;line-height:1.6;font-size:14px}.estimate .btn{width:100%;margin-top:15px}.contact{display:grid;grid-template-columns:1fr 1fr;gap:35px;background:#242321;color:white;border-radius:14px;overflow:hidden}.contact-text{padding:45px}.contact-form{padding:30px}.contact-form input,.contact-form textarea{background:#373633;color:white;border:1px solid #5b5750;width:100%;padding:13px;margin:8px 0;border-radius:5px}.contact-form input::placeholder,.contact-form textarea::placeholder{color:#c7c1b8}.footer{background:#1e1e1d;color:white;padding:35px 0}.footer .wrap{display:flex;justify-content:space-between;gap:20px;align-items:center}.note{font-size:12px;color:#999;line-height:1.5}.toast{position:fixed;right:20px;bottom:20px;background:#252420;color:white;padding:18px 24px;border-radius:9px;box-shadow:0 8px 30px #0004;z-index:100;display:none}.mobile{display:none}@media(max-width:850px){.links{display:none}.mobile{display:block}.hero{min-height:600px}.stats,.services,.advantages{grid-template-columns:repeat(2,1fr)}.projects,.reviews{grid-template-columns:1fr 1fr}.compare-layout,.about-grid,.calc-grid,.contact{grid-template-columns:1fr}.hero-body{padding:75px 0}.estimate{position:static}}@media(max-width:560px){.wrap{padding:0 18px}.nav{padding:17px 0}.nav>.btn{font-size:10px;padding:12px}.hero h1{font-size:43px}.hero{min-height:580px}.stats,.services,.advantages,.projects,.reviews{grid-template-columns:1fr}.stat{min-height:auto}.stats{padding-bottom:20px}.section-head{display:block}section{padding:58px 0}.compare{height:300px}.footer .wrap{display:block}.contact-text{padding:28px}.contact-form{padding:20px}}
</style><style>
:root{scroll-behavior:smooth}body{overflow-x:hidden}a,button,input{transition:all .3s ease}button,.btn,a.btn{position:relative;isolation:isolate}button:hover,.btn:hover,a.btn:hover{transform:translateY(-3px);filter:brightness(1.09);box-shadow:0 10px 32px rgba(214,171,109,.35),0 0 18px rgba(218,173,108,.28)}button:active,.btn:active{transform:translateY(0) scale(.98)}
#projects img{transition:transform .75s cubic-bezier(.2,.8,.2,1),filter .5s;filter:saturate(1.06)}#projects article:hover img,#projects .project-card:hover img{transform:scale(1.065)}
#services article,#services .service-card,#reviews article{transition:transform .35s,box-shadow .35s,border-color .35s}#services article:hover,#services .service-card:hover,#reviews article:hover{transform:translateY(-7px);box-shadow:0 20px 50px rgba(35,27,19,.15);border-color:#c49c65}
#projects{position:relative}#projects:before{content:'';position:absolute;inset:-80px 0 auto auto;width:350px;height:350px;background:radial-gradient(circle,rgba(205,162,98,.23),transparent 68%);pointer-events:none;animation:floatGlow 8s ease-in-out infinite alternate}
@keyframes floatGlow{to{transform:translate(-80px,65px) scale(1.2)}}
@keyframes revealUp{from{opacity:0;transform:translateY(35px)}to{opacity:1;transform:translateY(0)}}
.reveal{opacity:0;transform:translateY(35px)}.reveal.visible{animation:revealUp .75s ease forwards}
#beforeafter img{object-fit:cover}#compareRange{cursor:ew-resize;accent-color:#c7a06b}
@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation:none!important;transition:none!important}.reveal{opacity:1;transform:none}}
</style><style>
#services .service img{width:100%;height:180px;object-fit:cover;transition:transform .65s cubic-bezier(.2,.7,.2,1),filter .5s}
#services .service:hover img{transform:scale(1.07);filter:saturate(1.15)}
#projects .project img,.inspiration-tile img{transition:transform .7s ease,filter .5s}
#projects .project:hover img,.inspiration-tile:hover img{transform:scale(1.07);filter:saturate(1.13)}
.inspiration-strip{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;margin-top:35px}
.inspiration-tile{height:180px;position:relative;overflow:hidden;border-radius:15px;background:#38312c}
.inspiration-tile img{width:100%;height:100%;object-fit:cover}
.inspiration-tile:after{content:"";position:absolute;inset:40% 0 0;background:linear-gradient(transparent,rgba(0,0,0,.65));pointer-events:none}
.inspiration-tile span{position:absolute;z-index:2;left:18px;bottom:15px;color:white;font-weight:700}
@media(max-width:650px){.inspiration-strip{gap:8px}.inspiration-tile{height:125px}.inspiration-tile span{left:9px;font-size:12px}}
</style></head><body>
<header class="hero" id="home"><div class="wrap"><nav class="nav"><a class="brand" href="#home"><span>⌑</span>КЛЮЧ РЕМОНТ<small>РЕМОНТ КВАРТИР ПОД КЛЮЧ</small></a><div class="links"><a href="#services">Услуги</a><a href="#projects">Портфолио</a><a href="#beforeafter">До / После</a><a href="#about">О компании</a><a href="#reviews">Отзывы</a></div><a class="btn" href="#calculator">Рассчитать стоимость ↗</a></nav><div class="hero-body"><div class="eyebrow">Продуманный ремонт. Спокойная жизнь.</div><h1>Ремонт квартир<br/>под ключ <br/>без хаоса и затяжек</h1><p>От первого эскиза до финальной уборки. Берём на себя материалы, специалистов и контроль качества — вы получаете интерьер, в который хочется возвращаться.</p><div class="hero-actions"><a class="btn" href="#calculator">Рассчитать стоимость →</a><a class="btn outline" href="#projects">Смотреть проекты ↗</a></div></div><div class="stats"><div class="stat"><strong>01</strong><span>Один подрядчик<br/>на весь ремонт</span></div><div class="stat"><strong>02</strong><span>Прозрачная смета<br/>до начала работ</span></div><div class="stat"><strong>03</strong><span>Контроль качества<br/>на каждом этапе</span></div><div class="stat"><strong>04</strong><span>Поэтапная оплата<br/>по договору</span></div></div></div></header>
<section id="services"><div class="wrap"><div class="section-head"><div><div class="eyebrow">Наши услуги</div><h2>Ремонт, который<br/>подходит именно вам</h2></div><p class="sub">От лёгкого обновления до полной трансформации квартиры. Выберите масштаб — остальное организуем.</p></div><div class="services"><article class="service"><div class="service-body"><div class="symbol">♧</div><h3>Косметический</h3><p>Свежие стены, полы и детали. Быстрое обновление без глобальной перепланировки.</p></div><img alt="Современная гостиная с мягкой отделкой" data-fallback="data:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64," decoding="async" loading="lazy" src="https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&amp;fit=crop&amp;w=850&amp;q=85"/></article><article class="service"><div class="service-body"><div class="symbol">▤</div><h3>Капитальный</h3><p>Инженерия, электрика, сантехника и отделка — обновим квартиру основательно.</p></div><img alt="Современная ванная комната после капитального ремонта" data-fallback="data:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64," decoding="async" loading="lazy" src="https://images.unsplash.com/photo-1600566753190-17f0baa2a6c3?auto=format&amp;fit=crop&amp;w=850&amp;q=85"/></article><article class="service"><div class="service-body"><div class="symbol">♧</div><h3>Дизайнерский</h3><p>Продуманные сценарии света, индивидуальные решения и эстетика в каждой детали.</p></div><img alt="Дизайнерская кухня с тёплым освещением" data-fallback="data:image/jpeg;base64," decoding="async" loading="lazy" src="https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&amp;fit=crop&amp;w=850&amp;q=85"/></article><article class="service"><div class="service-body"><div class="symbol">▧</div><h3>Под ключ</h3><p>От концепции и закупок до сборки мебели и финальной уборки.</p></div><img alt="Современный интерьер квартиры под ключ" data-fallback="data:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64," decoding="async" loading="lazy" src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&amp;fit=crop&amp;w=850&amp;q=85"/></article></div><h2 style="margin:65px 0 25px">Почему выбирают нас</h2><div class="advantages"><div class="adv"><div class="symbol">▤</div><b>Понятная смета</b><p>Расписываем работы и материалы до старта.</p></div><div class="adv"><div class="symbol">◉</div><b>Поэтапная оплата</b><p>Вы платите за согласованные этапы работ.</p></div><div class="adv"><div class="symbol">▣</div><b>Контроль сроков</b><p>План работ и понятные контрольные точки.</p></div><div class="adv"><div class="symbol">⌑</div><b>Один контакт</b><p>Все вопросы решаются через менеджера проекта.</p></div></div></div></section>
<section class="dark" id="projects"><div class="wrap"><div class="section-head"><div><div class="eyebrow">Вдохновение для вашего ремонта</div><h2>Интерьеры, в которых<br/>хочется жить</h2></div><a class="btn outline" href="#beforeafter">Сравнить до и после →</a></div><div class="projects"><div class="project"><img alt="Современная гостиная — интерьерный референс" data-fallback="data:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64," loading="lazy" src="https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&amp;fit=crop&amp;w=1100&amp;q=85"/><div class="overlay"><b>Гостиная</b><span>Тёплый минимализм</span></div></div><div class="project"><img alt="Современная кухня — интерьерный референс" data-fallback="data:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64," loading="lazy" src="https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&amp;fit=crop&amp;w=1100&amp;q=85"/><div class="overlay"><b>Кухня</b><span>Эргономика и уют</span></div></div><div class="project"><img alt="Современная спальня — интерьерный референс" data-fallback="data:image/jpeg;base64," loading="lazy" src="https://images.unsplash.com/photo-1616594039964-ae9021a400a0?auto=format&amp;fit=crop&amp;w=1100&amp;q=85"/><div class="overlay"><b>Спальня</b><span>Спокойствие в деталях</span></div></div></div><p class="note" style="margin-top:16px">Изображения — демонстрационные интерьерные референсы, не портфолио выполненных заказов.</p></div></section>
<section id="beforeafter"><div class="wrap"><div class="section-head"><div><div class="eyebrow">Интерактивное сравнение</div><h2>До. После. Разница<br/>в каждом движении.</h2></div><p class="sub">Выберите комнату и двигайте ползунок, чтобы увидеть концептуальное преображение пространства.</p></div><div class="compare-layout"><div class="compare" id="compare"><img alt="После ремонта" data-fallback="data:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64," id="afterImg" src="https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?w=1200&amp;q=85&amp;fit=crop"/><img alt="До ремонта" class="before" data-fallback="data:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64," id="beforeImg" src="https://images.unsplash.com/photo-1560185127-6ed189bf02f4?w=1200&amp;q=85&amp;fit=crop"/><div class="line" id="compareLine"></div><div class="handle" id="compareHandle">◀ ▶</div><span class="tag left">ДО</span><span class="tag right">ПОСЛЕ</span><input aria-label="Сравнить до и после" id="compareRange" max="100" min="0" type="range" value="50"/></div><div><h2 id="compareTitle">Гостиная: новая атмосфера</h2><p class="sub" id="compareText">Светлая отделка, грамотная композиция мебели и уютный вечерний свет.</p><div class="tabs"><button class="tab active" data-room="0">Гостиная</button><button class="tab" data-room="1">Кухня</button><button class="tab" data-room="2">Спальня</button></div><p class="note">Демонстрация использует разные интерьерные изображения для иллюстрации идеи, а не подлинную пару фотографий одного объекта.</p><a class="btn" href="#calculator">Рассчитать похожий ремонт →</a></div></div><p style="font-size:12px;opacity:.75;margin-top:12px">Фото интерьеров — демонстрационные изображения из открытой фотобиблиотеки Unsplash. Сравнение «до/после» иллюстративное, не один и тот же объект.</p></div></section>
<section id="about" style="background:#eeece8"><div class="wrap about-grid"><div><div class="eyebrow">О компании</div><h2>Ремонт без лишних<br/>вопросов и стресса</h2><p class="sub">Наша философия проста: качественный ремонт должен быть предсказуемым. Поэтому мы начинаем с подробного плана, фиксируем объём работ и держим вас в курсе каждого этапа.</p><div class="check">✓ Персональный план работ</div><div class="check">✓ Прозрачный расчёт бюджета</div><div class="check">✓ Согласование материалов до закупки</div><div class="check">✓ Финальная проверка результата</div><a class="btn" href="#calculator" style="margin-top:25px">Обсудить мой проект →</a></div><img alt="Пример современного интерьера" class="about-img" data-fallback="data:image/jpeg;base64," loading="lazy" src="https://images.unsplash.com/photo-1600566753086-00f18fb6b3ea?auto=format&amp;fit=crop&amp;w=1200&amp;q=85"/></div></section>
<section id="reviews"><div class="wrap"><div class="section-head"><div><div class="eyebrow">Доверие в деталях</div><h2>Что важно нашим клиентам</h2></div><p class="sub">Ниже — примеры того, как может выглядеть раздел отзывов. Перед публикацией замените их подтверждёнными отзывами клиентов.</p></div><div class="reviews"><div class="review"><div class="stars">★★★★★</div><p>«Хотелось понимать, что происходит на объекте. Удобно, когда есть план работ и один ответственный человек».</p><b>Пример отзыва · Гостиная</b><br/><small>Демонстрационный текст</small></div><div class="review"><div class="stars">★★★★★</div><p>«Самое важное — заранее понимать бюджет и не принимать десятки решений в последний момент».</p><b>Пример отзыва · Кухня</b><br/><small>Демонстрационный текст</small></div><div class="review"><div class="stars">★★★★★</div><p>«Нам нужен был спокойный интерьер и понятная коммуникация на каждом этапе».</p><b>Пример отзыва · Спальня</b><br/><small>Демонстрационный текст</small></div></div><div class="inspiration-strip"><div class="inspiration-tile"><img alt="Интерьер: Гостиная" data-fallback="data:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64," loading="lazy" src="https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&amp;fit=crop&amp;w=850&amp;q=85"/><span>Гостиная</span></div><div class="inspiration-tile"><img alt="Интерьер: Кухня" data-fallback="data:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64,:image/jpeg;base64," loading="lazy" src="https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&amp;fit=crop&amp;w=850&amp;q=85"/><span>Кухня</span></div><div class="inspiration-tile"><img alt="Интерьер: Спальня" data-fallback="data:image/jpeg;base64," loading="lazy" src="https://images.unsplash.com/photo-1616594039964-ae9021a400a0?auto=format&amp;fit=crop&amp;w=850&amp;q=85"/><span>Спальня</span></div></div></div></section>
<section id="calculator" style="background:#eeece8"><div class="wrap"><div class="section-head"><div><div class="eyebrow">Расчёт за 30 секунд</div><h2>Сколько будет стоить<br/>ваш ремонт?</h2></div><p class="sub">Выберите параметры квартиры — калькулятор мгновенно покажет ориентировочный бюджет.</p></div><div class="calc-grid"><div class="form-box"><label for="area">Площадь квартиры: <strong id="areaValue">60</strong> м²</label><input id="area" max="200" min="20" step="1" type="range" value="60"/><label>Тип ремонта</label><div class="options" id="typeOptions"><button class="choice" data-type="cosmetic">Косметический</button><button class="choice active" data-type="capital">Капитальный</button><button class="choice" data-type="design">Дизайнерский</button></div><label>Дополнительные работы</label><div class="checks"><label><input id="designProject" type="checkbox"/> Дизайн-проект (+1 800 ₽/м²)</label><label><input id="electrics" type="checkbox"/> Дополнительная электрика (+2 200 ₽/м²)</label><label><input id="materials" type="checkbox"/> Материалы (+7 500 ₽/м²)</label></div><p class="note">Цены условные, для демонстрации работы калькулятора. Точную смету составляют после замера и уточнения работ.</p></div><aside class="estimate"><div class="eyebrow">Предварительная стоимость</div><div class="price" id="total">1 494 000 ₽</div><div id="rate">24 900 ₽/м² × 60 м²</div><p>Окончательная стоимость зависит от состояния квартиры, материалов, инженерных решений и состава работ.</p><a class="btn" href="#contact">Получить точную смету →</a><p class="note">Расчёт ни к чему не обязывает.</p></aside></div></div></section>
<section id="contact"><div class="wrap"><div class="contact"><div class="contact-text"><div class="eyebrow">Давайте обсудим ваш проект</div><h2>Ваш будущий дом<br/>начинается здесь</h2><p style="line-height:1.7;color:#d3ccc1">Оставьте контакт — обсудим задачу, сроки и подходящий формат ремонта. Без навязчивых продаж.</p></div><form class="contact-form" id="leadForm"><input id="name" minlength="2" placeholder="Ваше имя" required=""/><input id="phone" pattern="[+0-9()\s-]{8,20}" placeholder="Телефон" required="" title="Введите номер телефона" type="tel"/><textarea id="comment" placeholder="Расскажите о квартире и ваших пожеланиях" rows="4"></textarea><button class="btn" type="submit">Отправить заявку →</button><p class="note">Демо-форма: данные не отправляются на сервер. Для запуска подключите CRM или почту.</p></form></div></div></section><footer class="footer"><div class="wrap"><div class="brand"><span>⌑</span>КЛЮЧ РЕМОНТ<small>РЕМОНТ КВАРТИР ПОД КЛЮЧ</small></div><span class="note">Демонстрационный сайт · Контактные данные и условия уточняются перед запуском</span><a href="#home">Наверх ↑</a></div></footer><div class="toast" id="toast" role="status"></div>
<script>
const imgs=['https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?w=1200&q=85&fit=crop', 'https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?w=1200&q=85&fit=crop', 'https://images.unsplash.com/photo-1616594039964-ae9021a400a0?w=1200&q=85&fit=crop'];const beforeImgs=['https://images.unsplash.com/photo-1560185127-6ed189bf02f4?w=1200&q=85&fit=crop', 'https://images.unsplash.com/photo-1556911220-bff31c812dba?w=1200&q=85&fit=crop', 'https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?w=1200&q=85&fit=crop'];let room=0;const data=[['Гостиная: новая атмосфера','Светлая отделка, грамотная композиция мебели и уютный вечерний свет.'],['Кухня: пространство для жизни','Функциональные зоны, продуманное хранение и спокойная палитра.'],['Спальня: место силы','Мягкие фактуры, свет и ощущение уюта с первого взгляда.']];function setRoom(i){room=i;document.getElementById('afterImg').src=imgs[i];document.getElementById('beforeImg').src=beforeImgs[i];document.getElementById('compareTitle').textContent=data[i][0];document.getElementById('compareText').textContent=data[i][1];document.querySelectorAll('[data-room]').forEach(x=>x.classList.toggle('active',+x.dataset.room===i));document.getElementById('compareRange').value=50;move(50)}function move(v){document.getElementById('beforeImg').style.clipPath=`inset(0 ${100-v}% 0 0)`;document.getElementById('compareLine').style.left=v+'%';document.getElementById('compareHandle').style.left=v+'%'}document.getElementById('compareRange').addEventListener('input',e=>move(+e.target.value));document.querySelectorAll('[data-room]').forEach(x=>x.onclick=()=>setRoom(+x.dataset.room));let type='capital';const prices={cosmetic:18900,capital:24900,design:34900};function calc(){const a=+document.getElementById('area').value;document.getElementById('areaValue').textContent=a;const extra=(document.getElementById('designProject').checked?1800:0)+(document.getElementById('electrics').checked?2200:0)+(document.getElementById('materials').checked?7500:0);const rate=prices[type]+extra;const fmt=x=>new Intl.NumberFormat('ru-RU').format(x);document.getElementById('total').textContent=fmt(a*rate)+' ₽';document.getElementById('rate').textContent=fmt(rate)+' ₽/м² × '+a+' м²'}document.querySelectorAll('[data-type]').forEach(x=>x.onclick=()=>{type=x.dataset.type;document.querySelectorAll('[data-type]').forEach(y=>y.classList.toggle('active',y===x));calc()});['area','designProject','electrics','materials'].forEach(id=>document.getElementById(id).addEventListener('input',calc));calc();document.getElementById('leadForm').addEventListener('submit',e=>{e.preventDefault();const t=document.getElementById('toast');t.textContent='Форма проверена ✓ Это демоверсия: заявка не отправлена. Для приёма заявок подключите CRM.';t.style.display='block';setTimeout(()=>t.style.display='none',6500)});
</script><script>
const revealObserver=new IntersectionObserver((entries)=>entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('visible');revealObserver.unobserve(e.target)}}),{threshold:.09});document.querySelectorAll('section .section-head,section .project-card,section .service-card,section .review-card').forEach(el=>{el.classList.add('reveal');revealObserver.observe(el)});
document.querySelectorAll('#projects img,#beforeafter img').forEach(img=>{img.addEventListener('error',()=>{if(!img.dataset.fallback){img.dataset.fallback='1';img.src='https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?w=1200&q=80'}})});
</script><script>
(function(){
 const fallback = (img) => {if(img.dataset.fallback && img.src !== img.dataset.fallback){img.src=img.dataset.fallback;}};
 document.querySelectorAll('img[data-fallback]').forEach(img=>img.addEventListener('error',()=>fallback(img)));
 // Before/after room changes use internet photos; keep embedded backups if blocked.
 const observer=new MutationObserver(records=>records.forEach(r=>{const img=r.target;if(img.tagName==='IMG' && img.dataset.fallback){img.onerror=()=>fallback(img);}}));
 ['beforeImg','afterImg'].forEach(id=>{const img=document.getElementById(id);if(img)observer.observe(img,{attributes:true,attributeFilter:['src']});});
})();
</script></body></html>
